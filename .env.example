# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never expose to the client.
# Used by the seed script, and by the Ask/Tell test harness (app/actions.ts)
# to read/write since there's no login in front of it yet.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. From console.anthropic.com → API Keys. Powers the Ask/Tell
# test harness (classification + grounded Q&A).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional — defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-5

# Server-only. Shared password gating the Ask/Tell test harness before real
# auth exists — required in production (Vercel), optional in local dev
# (unset = open locally, locked if deployed without it). Pick any value;
# it never needs to be shared with anyone but the people testing this.
SITE_ACCESS_CODE=choose-a-password
